DATABASE_URL="postgresql://user:password@localhost:5432/ffprocess?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional — invitation emails. Without RESEND_API_KEY, invites still work:
# the accept link is shown directly in the Members UI instead of being emailed.
RESEND_API_KEY=""
EMAIL_FROM="FFProcess <onboarding@resend.dev>"

# Optional — AI process review and AI-drafted process templates, via the
# Gemini API. Without GEMINI_API_KEY those features still load; running one
# just returns a "not configured" message.
GEMINI_API_KEY=""
# Optional — overrides the default Gemini model (see lib/ai/gemini.ts).
GEMINI_MODEL=""

DATABASE_URL="postgresql://user:password@localhost:5432/ffprocess?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Optional — invitation emails. Without RESEND_API_KEY, invites still work:
# the accept link is shown directly in the Members UI instead of being emailed.
RESEND_API_KEY=""
EMAIL_FROM="FFProcess <onboarding@resend.dev>"

# Optional — AI process review, AI-drafted templates, and AI report drafting.
# Without GEMINI_API_KEY, those pages still load; running them just returns a
# "not configured" message. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
